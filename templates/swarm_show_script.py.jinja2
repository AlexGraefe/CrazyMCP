{% else %}
        await asyncio.sleep(0.1)
        print(f"Time: {elapsed:.2f}s, Setpoints: {setpoints}, Colors: {colors}, Finished: {finished}")
{% endif %}

    await swarm.land()


async def main():
    SwarmClass = SimulatedSwarm if {{ simulated }} else Swarm
    swarm = SwarmClass(testbed_min={{ testbed_min }}, testbed_max={{ testbed_max }})

    # Emergency stop: Ctrl+C (or SIGTERM / a closed terminal) cancels the show
    # task only. main() itself keeps running, so the emergency landing below
    # cannot be aborted by pressing Ctrl+C again. Without these handlers
    # asyncio.run() cancels main() with a CancelledError, which skips the
    # landing entirely and leaves the drones hovering.
    show_task = asyncio.create_task(run_show(swarm))
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        loop.add_signal_handler(sig, show_task.cancel)

    try:
        await show_task
    except (asyncio.CancelledError, Exception) as e:
        if isinstance(e, asyncio.CancelledError):
            print("\nInterrupted — performing emergency land...")
        else:
            print(f"Error during swarm show: {e}")
        try:
            await swarm.emergency_land()
        except Exception as land_error:
            print(f"Emergency land failed: {land_error}")
    finally:
        await swarm.disconnect()

if __name__ == "__main__":
    asyncio.run(main())