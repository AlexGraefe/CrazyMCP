async def run_show(swarm):
    await swarm.connect("{{ base_address }}", {{ num_drones }}, address_offset={{ address_offset }})
    await swarm.takeoff()

    start_time = asyncio.get_running_loop().time()
    while True:
        elapsed = asyncio.get_running_loop().time() - start_time
        result = swarm_show(elapsed)
        if len(result) == 4:
            setpoints, yaws, colors, finished = result
        else:  # legacy 3-tuple without LED colors
            setpoints, yaws, finished = result
            colors = None
        swarm.goto(setpoints, yaws, colors)
        if finished:
            break
{% if no_wait %}
