import asyncio
import sys
import os

sys.path.insert(0, "{{ project_root }}")

import numpy as np
from hardware import Swarm
from simulator import SimulatedSwarm
from visualization import SwarmVisualizer

{{ swarm_show_func }}

async def main():
    SwarmClass = SimulatedSwarm if {{ simulated }} else Swarm
    swarm = SwarmClass()

{% if visualize %}
    visualizer = SwarmVisualizer(swarm)
    await visualizer.start()
{% endif %}
    
    try:
        await swarm.connect("{{ base_address }}", {{ num_drones }}, address_offset={{ address_offset }})
        await swarm.takeoff()
        
        start_time = asyncio.get_running_loop().time()
        while True:
            elapsed = asyncio.get_running_loop().time() - start_time
            setpoints, yaws, finished = swarm_show(elapsed)
            swarm.goto(setpoints, yaws)
            if finished:
                break
{% if no_wait %}
            # await asyncio.sleep(0)
{% else %}
            await asyncio.sleep(0.1)
            print(f"Time: {elapsed:.2f}s, Setpoints: {setpoints}, Finished: {finished}")
{% endif %}
        
        await swarm.land()
    except (KeyboardInterrupt, Exception) as e:
        if isinstance(e, KeyboardInterrupt):
            print("\nInterrupted — performing emergency land...")
        else:
            print(f"Error during swarm show: {e}")
        try:
            await swarm.emergency_land()
        except Exception:
            pass
    finally:
{% if visualize %}
        await visualizer.stop()
{% endif %}
        await swarm.disconnect()

if __name__ == "__main__":
    asyncio.run(main())